      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{B002060B-74DF-4B3D-922D-9C6A5E2FB81F}"
          SQLTask:SqlStatementSource="UPDATE dbo.data_flow&#xA;SET CET = DATEADD(MONTH, 1, LSET)&#xA;WHERE name = 'order_payments';" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Set LSET"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{87F5713A-43ED-404E-953A-2B5BBC6E92CF}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Set LSET"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{B002060B-74DF-4B3D-922D-9C6A5E2FB81F}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;SET XACT_ABORT ON;&#xA;&#xA;DECLARE @BatchID INT = ?;&#xA;&#xA;BEGIN TRY&#xA;    BEGIN TRANSACTION;&#xA;&#xA;    UPDATE f&#xA;    SET f.LSET = b.CET&#xA;    FROM dbo.data_flow AS f&#xA;    INNER JOIN dbo.etl_batch AS b&#xA;        ON b.flow_name = f.name&#xA;    WHERE b.batch_id = @BatchID&#xA;      AND b.[status] = 'Running'&#xA;      AND f.LSET = b.LSET&#xA;      AND f.CET = b.CET;&#xA;&#xA;    IF @@ROWCOUNT &lt;&gt; 1&#xA;    BEGIN&#xA;        THROW 50002,&#xA;              N'Khong the cap nhat watermark: batch hoac moc khong hop le.',&#xA;              1;&#xA;    END;&#xA;&#xA;    UPDATE dbo.etl_batch&#xA;    SET [status] = 'Success',&#xA;        ended_at = SYSDATETIME(),&#xA;        error_message = NULL&#xA;    WHERE batch_id = @BatchID&#xA;      AND [status] = 'Running';&#xA;&#xA;    IF @@ROWCOUNT &lt;&gt; 1&#xA;    BEGIN&#xA;        THROW 50003,&#xA;              N'Khong the cap nhat trang thai batch.',&#xA;              1;&#xA;    END;&#xA;&#xA;    COMMIT TRANSACTION;&#xA;END TRY&#xA;BEGIN CATCH&#xA;    IF XACT_STATE() &lt;&gt; 0&#xA;        ROLLBACK TRANSACTION;&#xA;&#xA;    THROW;&#xA;END CATCH;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::BatchID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
