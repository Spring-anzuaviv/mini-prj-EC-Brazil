  <DTS:Executables>
    <DTS:Executable
      DTS:refId="Package\Clear Payments In Range"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{5383128A-B402-4DB4-98BB-E0B090B84C49}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Clear Payments In Range"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{2B6DAE0D-B58D-41AF-A97A-AD78BC6DE718}"
          SQLTask:SqlStatementSource="DECLARE @BatchID INT = ?;&#xA;DECLARE @LSET DATETIME;&#xA;DECLARE @CET DATETIME;&#xA;&#xA;SELECT&#xA;    @LSET = LSET,&#xA;    @CET = CET&#xA;FROM Olist_Metadata.dbo.etl_batch&#xA;WHERE batch_id = @BatchID&#xA;  AND flow_name = 'order_payments';&#xA;&#xA;IF @LSET IS NULL OR @CET IS NULL OR @LSET &gt;= @CET&#xA;BEGIN&#xA;    THROW 50001, N'Batch order_payments khong hop le.', 1;&#xA;END;&#xA;&#xA;DELETE p&#xA;FROM dbo.stg_order_payments AS p&#xA;WHERE EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM dbo.stg_orders AS o&#xA;    WHERE o.order_id = p.order_id&#xA;      AND CONVERT(DATETIME, o.order_purchase_timestamp, 120) &gt;= @LSET&#xA;      AND CONVERT(DATETIME, o.order_purchase_timestamp, 120) &lt; @CET&#xA;);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::BatchID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Create Batch"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{21FBD6E9-9474-4D2E-A34E-04CCA718A734}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Create Batch"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{B002060B-74DF-4B3D-922D-9C6A5E2FB81F}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;&#xA;INSERT INTO dbo.etl_batch&#xA;(&#xA;    flow_name,&#xA;    LSET,&#xA;    CET,&#xA;    [status]&#xA;)&#xA;OUTPUT INSERTED.batch_id AS batch_id&#xA;SELECT&#xA;    name,&#xA;    LSET,&#xA;    CET,&#xA;    'Running'&#xA;FROM dbo.data_flow&#xA;WHERE name = 'order_payments';&#xA;&#xA;IF @@ROWCOUNT &lt;&gt; 1&#xA;BEGIN&#xA;    THROW 50001,&#xA;          N'Khong tim thay duy nhat mot flow orders.',&#xA;          1;&#xA;END;"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="0"
            SQLTask:DtsVariableName="User::BatchID" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
