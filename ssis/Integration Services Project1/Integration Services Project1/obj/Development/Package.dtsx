        <SQLTask:SqlTaskData
          SQLTask:Connection="{48AB2F3A-E713-4E2F-B118-A7471F53DD40}"
          SQLTask:SqlStatementSource="IF OBJECT_ID(N'dbo.stg_customers', N'U') IS NOT NULL&#xA;    TRUNCATE TABLE dbo.stg_customers;&#xA;&#xA;IF OBJECT_ID(N'dbo.stg_products', N'U') IS NOT NULL&#xA;    TRUNCATE TABLE dbo.stg_products;&#xA;&#xA;IF OBJECT_ID(N'dbo.stg_sellers', N'U') IS NOT NULL&#xA;    TRUNCATE TABLE dbo.stg_sellers;&#xA;&#xA;IF OBJECT_ID(N'dbo.stg_geolocation', N'U') IS NOT NULL&#xA;    TRUNCATE TABLE dbo.stg_geolocation;&#xA;&#xA;IF OBJECT_ID(N'dbo.stg_category_translation', N'U') IS NOT NULL&#xA;    TRUNCATE TABLE dbo.stg_category_translation;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
